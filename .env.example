# ---------------------------------------------------------------------------
# Atlas environment variables
#
# Copy to .env.local for development. NEVER commit a real .env file.
# Each environment (local, preview, staging, production) uses its own values
# per docs/03-security-and-access.md §9 and architecture §18.
#
# Validated at boot by src/config/env.ts — a missing or malformed value fails
# the build rather than surfacing at runtime (ATL-001). Environment isolation is
# asserted at the same time (ATL-003): see supabase/README.md.
#
# Where values come from, per environment:
#   local       this file, copied to .env.local (never committed)
#   preview     CI environment variables
#   staging     deployment platform secret store, scoped to staging
#   production  deployment platform secret store, scoped to production, restricted
#
# Keys are NEVER shared between environments. Generate ATLAS_KEK and
# AUDIT_HMAC_KEY independently for each one.
# ---------------------------------------------------------------------------

# --- Public (safe to expose to the browser) --------------------------------
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Server-only: never prefix these with NEXT_PUBLIC ----------------------
# Bypasses RLS. Server-only modules only (security §6).
SUPABASE_SERVICE_ROLE_KEY=""

# Application-layer encryption key (KEK) — ADR-003.
# 32 bytes, base64-encoded. Generate: openssl rand -base64 32
#
# Wraps every per-user DEK. Never in the repository, a client bundle, or a log.
# In hosted environments it comes from managed secret storage only.
ATLAS_KEK=""
ATLAS_KEK_VERSION="1"

# The superseded KEK, set ONLY while a rotation sweep is in flight (ATL-084).
#
# Re-wrapping every DEK is not instantaneous. Until the sweep finishes, some
# rows are still wrapped under the old generation and the process needs both
# keys to read them. Set BOTH or NEITHER — a half-set pair fails the boot.
#
# Rotation procedure:
#   1. Generate a new key; move the old value to ATLAS_KEK_PREVIOUS and its
#      number to ATLAS_KEK_PREVIOUS_VERSION.
#   2. Set ATLAS_KEK to the new key and increment ATLAS_KEK_VERSION.
#   3. Deploy, then run the re-wrap sweep until it reports zero remaining.
#   4. Unset both PREVIOUS values and deploy again.
# No data row is touched at any point — only the wrapped DEKs change.
ATLAS_KEK_PREVIOUS=""
ATLAS_KEK_PREVIOUS_VERSION=""

# HMAC key for pseudonymous audit subject references — ADR-006.
# 32 bytes, base64-encoded. Generate: openssl rand -base64 32
AUDIT_HMAC_KEY=""

# AI provider — server-only (security §10). Unused until milestone M7.
ANTHROPIC_API_KEY=""

# Operational kill switch for every AI surface (ATL-052). Defaults to true when
# unset, so leaving this blank preserves normal behaviour. Set to "false" during
# a provider incident: Atlas then performs no consent read, no AI retrieval and
# no provider call, and every AI surface serves deterministic text instead.
AI_ENABLED="true"

# --- Google OAuth (ATL-011, security §5) -----------------------------------
# OPTIONAL. Magic link is the primary method and the application works fully
# without Google. Set BOTH or NEITHER — a half-configured provider fails the
# boot (google-oauth-requires-both-credentials).
#
# Server-only: the browser receives the consent URL the server builds, never
# the client secret. Enable the provider in supabase/config.toml per environment.
ATLAS_GOOGLE_CLIENT_ID=""
ATLAS_GOOGLE_CLIENT_SECRET=""

# Rate-limit store — required; serverless cannot rate-limit in memory
# (architecture §3). Provider selection is open question OQ-09.
RATE_LIMIT_REDIS_URL=""
RATE_LIMIT_REDIS_TOKEN=""

# --- Error monitoring (ATL-095, architecture §16) --------------------------
# Optional locally; REQUIRED in staging and production, where the isolation
# rules also require https and a distinct credential per environment.
#
# Deliberately NOT NEXT_PUBLIC. The browser reports to /api/monitoring/error
# and the server forwards, so this credential never enters a client bundle.
#
# The vendor is open question OQ-09: the transport is provider-agnostic, so
# selecting one is a config change plus an adapter, not a rewrite.
ATLAS_MONITORING_ENDPOINT=""
ATLAS_MONITORING_KEY=""

# Release tag for monitoring. Falls back to the platform commit SHA
# (VERCEL_GIT_COMMIT_SHA / GITHUB_SHA), then to "unknown".
ATLAS_RELEASE=""

# --- Optional --------------------------------------------------------------
# NODE_ENV is set by the framework; do not override in .env files.
ATLAS_ENV="local"          # local | preview | staging | production
ATLAS_LOG_LEVEL="info"     # debug | info | warn | error

# Optional but recommended in staging and CI. When set, a lower environment that
# points at the production Supabase project fails its isolation check instead of
# silently reading production data (architecture §18).
# ATLAS_PRODUCTION_PROJECT_REF=""
