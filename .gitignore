*.tsbuildinfo

# Vercel
.vercel

# Local scratch — never commit exported or real user data
/tmp/
/scratch/
*.export.json

# NOTE: gate fixtures are deliberately NOT ignored here.
# Prettier honours .gitignore and the secret scanner only inspects files that could
# enter the repository, so ignoring fixtures silently disables those gates during
# `pnpm gates:verify`. Safety comes instead from the verifier itself: it refuses to
# overwrite an existing path, always removes fixtures in a `finally`, and fails if a
# fixture survives.

# Playwright authenticated session (ATL-012 E2E support). A real session
# cookie for a throwaway local user — regenerated by the setup project.
tests/.auth/
