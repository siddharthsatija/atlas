{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Atlas \u2014 personal digital identity and privacy management",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "next build",
    "ci:verify-policy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-ci-policy.mts",
    "db:lint": "supabase db lint",
    "db:migrate:local": "pnpm db:reset",
    "db:migrate:status": "supabase migration list",
    "db:reset": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/check-environment.mts --require local --skip-connectivity && supabase db reset",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:types": "supabase gen types typescript --local > src/types/database.generated.ts",
    "db:validate-migrations": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-migrations.mts",
    "deps:verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-dependencies.mts",
    "dev": "next dev",
    "env:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/check-environment.mts",
    "env:check:production": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-environment.mts --env production",
    "env:check:staging": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-environment.mts --env staging",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gates:verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-gates.mts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "scan:secrets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/scan-secrets.mts",
    "start": "next start",
    "sync:pr-template": "node scripts/sync-pr-template.mjs",
    "test": "vitest run",
    "test:a11y": "playwright test --grep @a11y",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:all": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:pr-template": "node scripts/sync-pr-template.mjs --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@hookform/resolvers": "5.5.7",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "12.43.0",
    "lucide-react": "1.27.0",
    "next": "16.2.12",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.83.0",
    "react-is": "19.0.8",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-testing-library": "7.16.2",
    "husky": "9.1.7",
    "jest-axe": "11.0.0",
    "jsdom": "30.0.1",
    "lint-staged": "17.2.0",
    "prettier": "3.9.6",
    "prettier-plugin-sql": "0.20.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.110.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "brace-expansion@^1.0.0": "1.1.18",
      "brace-expansion@^5.0.0": "5.0.9",
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  }
}
